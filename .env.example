# 线上 MPC 服务基础地址，冒烟测试脚本使用。
MPC_ONLINE_BASE_URL=http://127.0.0.1:8000

# 服务器拉取的镜像地址。使用 docker-compose.release.yml 时必须配置。
# 示例：registry.cn-guangzhou.aliyuncs.com/your_namespace/mpc-online:20260612-001
MPC_ONLINE_IMAGE=

# 宿主机对外暴露端口；容器内固定为 8000。
MPC_ONLINE_PORT=8000

# 容器名称。
MPC_ONLINE_CONTAINER_NAME=mpc-online-platform

# 数据库连接地址。
# 本地 Docker 单机部署默认使用容器内 SQLite 文件，并通过 ./data 挂载持久化。
MPC_DATABASE_URL=sqlite:////app/data/mpc_online.db

# 云端数据接收接口的 HMAC-SHA256 共享密钥。
# 留空表示不强制签名；线上跨系统调用建议配置为随机长密钥。
MPC_INPUT_SIGNATURE_SECRET=

# 储能功率符号模式：
# signed_meter 表示采集源已经提供正放电/负充电的有符号功率；
# soc_delta 表示采集源只有功率绝对值，需要用 SOC 变化判断充放电方向。
MPC_BATTERY_POWER_MODE=signed_meter

# 数据库维护配置。
# 原始数据默认保留 30 天；15 分钟聚合和 MPC 结果默认保留 365 天。
# 维护命令默认 dry-run，只有显式传 --execute 才会先备份再删除。
MPC_DB_BACKUP_DIR=/app/data/backups
MPC_RAW_RETENTION_DAYS=30
MPC_TELEMETRY_RETENTION_DAYS=365
MPC_RESULT_RETENTION_DAYS=365
MPC_CONTROL_API_RETENTION_DAYS=365
MPC_BACKUP_RETENTION_DAYS=30

# 冒烟测试使用的工厂 ID。
MPC_SMOKE_PLANT_ID=smoke_factory
